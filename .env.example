# Copy to .env for local runs. Never commit real values.

# Required for the HTTP transport. Every /mcp request must send it, either as
#   https://<host>/mcp/<MCP_AUTH_TOKEN>          (claude.ai custom connector URL)
# or as the header
#   Authorization: Bearer <MCP_AUTH_TOKEN>       (Claude Code / scripts, URL https://<host>/mcp)
# Unset, empty or shorter than 32 chars => every /mcp request gets 503 (fail closed).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=

# Notion integration token and the default parent page for handoff pages.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=
# Optional: extra parent pages a caller may pick with notion_parent_page_id (comma-separated ids or URLs).
NOTION_ALLOWED_PARENT_PAGE_IDS=
# Optional: max Notion pages created per UTC day by this process (default 50).
NOTION_MAX_PAGES_PER_DAY=

# Optional hardening knobs.
MCP_RATE_LIMIT_PER_MIN=   # default 120 requests/min per client IP on /mcp
MAX_BODY_SIZE=            # default 1mb, capped at 4mb

# http (default) or stdio. stdio is local-only and needs no MCP_AUTH_TOKEN.
TRANSPORT=http
